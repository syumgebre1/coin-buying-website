rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is an admin
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Users collection
    match /users/{userId} {
      // Anyone can read users (needed for login by username, checking invite codes)
      // Only the user themselves or an admin can write
      allow read: if true; 
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
    
    // For all other collections (transactions, withdrawals, etc.)
    match /{document=**} {
      allow read, write: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
    }
  }
}
